{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar proyecto (javac)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$files = Get-ChildItem -Recurse -Filter *.java '${workspaceFolder}/src/main/java' | ForEach-Object { $_.FullName }; & '${env:JAVA_HOME}/bin/javac.exe' -encoding UTF-8 -d '${workspaceFolder}/bin' $files",
                "if ($LASTEXITCODE -eq 0) { Write-Host 'Compilacion correcta' }"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Ejecutar archivo abierto",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "& '${env:JAVA_HOME}/bin/java.exe' -cp '${workspaceFolder}/bin' '${fileDirname}/${fileBasenameNoExtension}'"
            ],
            "dependsOn": "Compilar proyecto (javac)",
            "problemMatcher": []
        }
    ]
}